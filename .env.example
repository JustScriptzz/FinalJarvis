# ---------------------------------------------------------------------------
# JARVIS environment. Copy to .env and fill in only what you use.
# Everything here is read by config/config.yaml through ${VAR} expansion.
# ---------------------------------------------------------------------------

# --- Core server -----------------------------------------------------------
JARVIS_CONFIG=./config/config.yaml
JARVIS_API_TOKEN=            # leave empty for localhost-only development
JARVIS_LOG_LEVEL=INFO

# --- LiveKit (required by docker compose) ----------------------------------
LIVEKIT_API_KEY=devkey
# Generate with: openssl rand -hex 32
LIVEKIT_API_SECRET=change-me-to-a-random-32-byte-secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- Local model endpoints -------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=ollama
KOKORO_BASE_URL=http://localhost:8880/v1
SPEACHES_BASE_URL=http://localhost:8001/v1

# --- Cloud LLM keys (enable the provider in config.yaml after adding a key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Cloud speech keys -----------------------------------------------------
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# --- Telephony (Phase 3) ---------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=

# --- Omnichannel (Phase 4) -------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# Gmail / Outlook OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=
EMAIL_ADDRESS=
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_PASSWORD=

# WhatsApp bridge (Baileys microservice, Phase 4)
WHATSAPP_BRIDGE_URL=http://localhost:3001
WHATSAPP_BRIDGE_TOKEN=

# --- Security --------------------------------------------------------------
# Comma-separated CIDRs allowed to reach the API when api_token is empty.
JARVIS_TRUSTED_NETWORKS=127.0.0.1/32,::1/128
